{
  "name": "ajax-proxy",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "description": "Mock missing APIs, replace browser responses, and redirect requests.",
  "version": "3.0.2",
  "scripts": {
    "watch": "run-p watch:protocol watch:utils watch:lib watch:chrome",
    "watch:protocol": "pnpm -C ./packages/protocol watch",
    "watch:utils": "pnpm -C ./packages/shared-utils watch",
    "watch:lib": "pnpm -C ./packages/proxy-lib watch",
    "build": "pnpm build:all && node scripts/pkg.cjs",
    "build:inputs": "pnpm -r --filter '@proxy/shell-chrome^...' build && pnpm -r --filter '@proxy/vue3-panels...' build",
    "build:all": "pnpm build:inputs && pnpm -C ./packages/shell-chrome build",
    "build:lib": "pnpm -C ./packages/proxy-lib build",
    "build:protocol": "pnpm -C ./packages/protocol build",
    "build:utils": "pnpm build:protocol && pnpm -C ./packages/shared-utils build",
    "build:chrome": "pnpm build:all",
    "watch:chrome": "pnpm build:all && node ./scripts/build-shell-vite.cjs --watch",
    "verify:chrome:vite-watch": "pnpm build:all && node ./scripts/verify-shell-vite-watch.cjs",
    "build:v3-panels": "pnpm -C ./packages/vue3-panels build",
    "preview:v3-panels": "pnpm -C ./packages/vue3-panels preview",
    "typecheck": "pnpm -C ./packages/protocol exec tsc --noEmit && pnpm -C ./packages/shared-utils exec tsc --noEmit && pnpm -C ./packages/proxy-lib exec tsc --noEmit && pnpm -C ./packages/v3-domain exec tsc --noEmit && pnpm -C ./packages/shell-chrome exec tsc --noEmit",
    "format:check": "pnpm format:strict && node ./scripts/check-source-format-baseline.cjs",
    "format:strict": "prettier --check \"REFACTOR_V3_PLAN.zh.md\" \"docs/**/*.md\" \"package.json\" \"vitest.config.mjs\" \".prettierrc.json\" \"eslint.config.mjs\" \".github/workflows/*.yml\" \"packages/proxy-lib/test/**/*.ts\" \"tests/**/*.cjs\" \"scripts/**/*.cjs\"",
    "lint": "pnpm lint:all && pnpm lint:migrated",
    "lint:migrated": "eslint \"packages/proxy-lib/test/**/*.ts\" \"tests/**/*.cjs\" \"scripts/**/*.cjs\" \"vitest.config.mjs\" \"eslint.config.mjs\" --max-warnings=0",
    "check:boundaries": "node ./scripts/check-package-boundaries.cjs && pnpm check:v3-panel-isolation",
    "check:v3-panel-isolation": "node ./scripts/check-v3-panel-isolation.cjs",
    "lint:all": "eslint \"packages/{protocol,shared-utils,proxy-lib,shell-chrome,v3-domain,vue3-panels}/**/*.{js,ts,vue}\" --max-warnings=378",
    "check:generated-types": "node ./scripts/check-generated-types.cjs",
    "security:audit": "pnpm audit --prod --audit-level=moderate --registry=https://registry.npmjs.org && pnpm audit signatures --registry=https://registry.npmjs.org",
    "test": "vitest run",
    "test:v3-ui": "pnpm -C packages/vue3-panels exec vitest run --config vitest.component.config.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "playground:smoke": "node ./tests/browser/playground-smoke.cjs",
    "browser:smoke": "node ./tests/browser/runtime-smoke.cjs",
    "v3:browser:smoke": "pnpm build:protocol && pnpm -C packages/v3-domain build && node ./tests/browser/v3-runtime-smoke.cjs",
    "v3:function:smoke": "node ./tests/browser/v3-function-smoke.cjs",
    "v3:sandbox:smoke": "pnpm build && node ./tests/browser/v3-sandbox-smoke.cjs",
    "v3:panel:responsive:smoke": "pnpm build:v3-panels && node ./tests/browser/v3-panel-responsive-smoke.cjs",
    "v3:extension:smoke": "node ./tests/browser/v3-extension-smoke.cjs",
    "production:smoke": "node ./tests/production-extension-layout-smoke.cjs",
    "brand:icons": "node scripts/render-brand-icons.cjs",
    "clean:build": "rm -rf ./packages/proxy-lib/lib ./packages/proxy-lib/types ./packages/protocol/lib ./packages/protocol/types ./packages/shared-utils/lib ./packages/shared-utils/types ./packages/v3-domain/lib ./packages/v3-domain/types ./packages/shell-chrome/build ./packages/shell-chrome/build-vite ./packages/shell-chrome/build-vite-dev ./packages/vue3-panels/dist",
    "size:report": "node ./scripts/report-bundle-size.cjs",
    "release": "node release.js",
    "pkg": "node ./scripts/pkg.cjs",
    "zip": "node ./extension-zips.js",
    "preinstall": "npx only-allow pnpm"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/g0ngjie/ajax-proxy.git"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "keywords": [],
  "author": {
    "name": "Gj",
    "email": "gongjie0422@163.com"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/g0ngjie/ajax-proxy/issues"
  },
  "homepage": "https://github.com/g0ngjie/ajax-proxy#readme",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitest/coverage-v8": "^5.0.1",
    "@vue/test-utils": "^2.5.1",
    "archiver": "^5.3.1",
    "eslint": "10.11.0",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.12.0",
    "inquirer": "6.2.0",
    "jsdom": "^30.1.1",
    "npm-run-all": "^4.1.5",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "progress": "^2.0.3",
    "readdir-glob": "^1.1.2",
    "semver": "^7.3.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "^6.4.3",
    "vitest": "^5.0.1"
  }
}

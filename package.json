{
  "name": "ajax-proxy",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "description": "Modify your Ajax response to test",
  "version": "2.2.10",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--openssl-legacy-provider pnpm -C ./packages/vue-panels serve",
    "watch": "cross-env NODE_OPTIONS=--openssl-legacy-provider run-p watch:protocol watch:utils watch:lib watch:chrome",
    "watch:protocol": "pnpm -C ./packages/protocol watch",
    "watch:utils": "pnpm -C ./packages/shared-utils watch",
    "watch:lib": "pnpm -C ./packages/proxy-lib watch",
    "watch:chrome": "cross-env NODE_OPTIONS=--openssl-legacy-provider pnpm -C ./packages/shell-chrome watch",
    "build": "cross-env NODE_OPTIONS=--openssl-legacy-provider run-s build:all pkg",
    "build:all": "cross-env NODE_OPTIONS=--openssl-legacy-provider pnpm -F \"./packages/**\" build",
    "build:lib": "pnpm -C ./packages/proxy-lib build",
    "build:protocol": "pnpm -C ./packages/protocol build",
    "build:utils": "pnpm build:protocol && pnpm -C ./packages/shared-utils build",
    "build:chrome": "cross-env NODE_OPTIONS=--openssl-legacy-provider pnpm -C ./packages/shell-chrome build",
    "build:comp": "pnpm -C ./packages/v2-compatibility build",
    "build:panels": "cross-env NODE_OPTIONS=--openssl-legacy-provider pnpm -C ./packages/vue-panels build",
    "typecheck": "pnpm -C ./packages/protocol exec tsc --noEmit && pnpm -C ./packages/shared-utils exec tsc --noEmit && pnpm -C ./packages/proxy-lib exec tsc --noEmit && pnpm -C ./packages/v2-compatibility exec tsc --noEmit && pnpm -C ./packages/v3-domain exec tsc --noEmit && pnpm -C ./packages/shell-chrome exec tsc --noEmit",
    "format:check": "pnpm format:strict && node ./scripts/check-source-format-baseline.cjs",
    "format:strict": "prettier --check \"REFACTOR_V3_PLAN.zh.md\" \"docs/**/*.md\" \"package.json\" \"vitest.config.mjs\" \".prettierrc.json\" \"eslint.config.mjs\" \".github/workflows/*.yml\" \"packages/proxy-lib/test/**/*.ts\" \"tests/**/*.cjs\" \"scripts/**/*.cjs\"",
    "lint": "pnpm lint:all && pnpm lint:migrated",
    "lint:migrated": "eslint \"packages/proxy-lib/test/**/*.ts\" \"tests/**/*.cjs\" \"scripts/**/*.cjs\" \"vitest.config.mjs\" \"eslint.config.mjs\" --max-warnings=0",
    "check:boundaries": "node ./scripts/check-package-boundaries.cjs",
    "lint:all": "eslint \"packages/**/*.{js,ts,vue}\" --max-warnings=378",
    "check:generated-types": "node ./scripts/check-generated-types.cjs",
    "security:audit": "pnpm audit --prod --audit-level=moderate --registry=https://registry.npmjs.org && pnpm audit signatures --registry=https://registry.npmjs.org",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "browser:smoke": "node ./tests/browser/runtime-smoke.cjs",
    "v3:browser:smoke": "pnpm build:protocol && pnpm -C packages/v3-domain build && node ./tests/browser/v3-runtime-smoke.cjs",
    "extension:smoke": "node ./tests/browser/extension-smoke.cjs",
    "editor:smoke": "node ./tests/browser/json-editor-error-smoke.cjs",
    "clean:build": "rm -rf ./packages/code-editor/lib ./packages/json-editor/lib ./packages/proxy-lib/lib ./packages/proxy-lib/types ./packages/protocol/lib ./packages/protocol/types ./packages/shared-utils/lib ./packages/shared-utils/types ./packages/v2-compatibility/lib ./packages/v2-compatibility/types ./packages/v3-domain/lib ./packages/v3-domain/types ./packages/shell-chrome/build ./packages/vue-panels/dist",
    "size:report": "node ./scripts/report-bundle-size.cjs",
    "release": "node release.js",
    "pkg": "cp -r ./packages/vue-panels/dist ./packages/shell-chrome/build/panels",
    "zip": "node ./extension-zips.js",
    "preinstall": "npx only-allow pnpm"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/g0ngjie/ajax-proxy.git"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "keywords": [],
  "author": {
    "name": "Gj",
    "email": "gongjie0422@163.com"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/g0ngjie/ajax-proxy/issues"
  },
  "homepage": "https://github.com/g0ngjie/ajax-proxy#readme",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitest/coverage-v8": "^5.0.1",
    "archiver": "^5.3.1",
    "cross-env": "^10.1.0",
    "eslint": "10.11.0",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.12.0",
    "inquirer": "6.2.0",
    "npm-run-all": "^4.1.5",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "progress": "^2.0.3",
    "readdir-glob": "^1.1.2",
    "semver": "^7.3.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "^6.4.3",
    "vitest": "^5.0.1"
  }
}
